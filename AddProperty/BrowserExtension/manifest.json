{
  "manifest_version": 3,
  "name": "Idealista Capture Helper",
  "version": "1.1",
  "description": "Reads listing data from Idealista pages and sends it to your local AddProperty app. Click the toolbar icon to toggle auto-crawl on/off.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://www.idealista.pt/*",
    "http://localhost:5099/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "content_scripts": [
    {
      "matches": [
        "https://www.idealista.pt/comprar-casas/faro-distrito/com-apartamentos*",
        "https://www.idealista.pt/imovel/*"
      ],
      "js": ["consent.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.idealista.pt/comprar-casas/faro-distrito/com-apartamentos*"],
      "js": ["content-search.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.idealista.pt/imovel/*"],
      "exclude_matches": ["https://www.idealista.pt/imovel/*/mapa*"],
      "js": ["content-ad.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.idealista.pt/imovel/*/mapa*"],
      "js": ["content-map.js"],
      "run_at": "document_idle"
    }
  ]
}
